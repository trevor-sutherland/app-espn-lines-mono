# Production image for the Nest API.
# Build from repo root (Cloud Console: Dockerfile = Dockerfile.api, context = .):
#   docker build -f Dockerfile.api -t espn-lines-api .

FROM node:22-bookworm AS builder

WORKDIR /app

ENV NX_DAEMON=false
ENV NX_CACHE_DIRECTORY=/tmp/nx-cache
ENV NX_WORKSPACE_DATA_DIRECTORY=/tmp/nx-workspace

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx nx build @app-espn-lines-mono/api --configuration=production

FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NX_DAEMON=false
# Do not set PORT here. Cloud Run injects PORT (default 8080) and health-checks
# that port. Local `docker run` can pass -e PORT=3000; main.ts defaults to 3000.

# Webpack generatePackageJson writes runtime deps into api/dist/package.json.
# Do not nx prune — api/package.json has empty dependencies and would wipe that list.
# argon2 install scripts must run (native addon).
COPY --from=builder /app/api/dist ./api/dist
RUN cd api/dist && npm install --omit=dev --legacy-peer-deps

# Mailer looks up templates at <cwd>/api/src/lib/mailer/templates
COPY --from=builder /app/api/src/lib/mailer/templates ./api/src/lib/mailer/templates

EXPOSE 8080

CMD ["node", "api/dist/main.js"]
