# Copy to .env and fill in real values:
#   cp .env.example .env

# Required
JWT_SECRET=change-me-to-a-long-random-string
ODDS_API_KEY=

# Admin account (seeded into Mongo on API startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=Admin

# Odds API defaults (optional)
ODDS_API_MARKETS=spreads,totals
ODDS_API_BOOKMAKERS=draftkings
ODDS_API_FORMAT=american

# App URLs (browser-facing; docker compose overrides MONGO_URI for the api service)
WEB_APP_URL=http://localhost:4200
MONGO_URI=mongodb://localhost:27017/espn-lines
# Do NOT set PORT here — Angular/Vite treat PORT as the UI dev-server port.
# API port is set in docker-compose (api service) or defaults to 3000 in main.ts.

# Password-reset / email-change (Gmail example)
# Create an App Password at: Google Account → Security → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Spreadhead Picks <you@gmail.com>"

# Pick confirmation emails wait this long, then send one at a time.
# PICK_EMAIL_DELAY_MS=120000
